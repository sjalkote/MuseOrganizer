# Copy to .env. Any key left blank runs that service in mock mode.

# Meta Model API (Muse Spark / Image / Voice Transcribe) — https://dev.meta.ai
MODEL_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3

# SerpApi — https://serpapi.com/manage-api-key
# Responses are cached in fixtures/serpapi/ and replayed offline; delete a file to refresh it.
SERPAPI_API_KEY=

# Google Drive for plan folders — docs/GOOGLE_WORKSPACE_SETUP.md. Use the *web* OAuth client.
# Blank: builds write CSV/Markdown to fixtures/drive/<plan>/ and return a fake folder link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the web client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Seconds between steps in mock builds, so the app's progress list visibly fills in.
HUDDLE_MOCK_PACE=0.25
