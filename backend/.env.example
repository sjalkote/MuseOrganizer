# Copy to .env. Do not commit this file.
# A plan build from the app needs SerpAPI. Set MUSE_ENABLED=1 with MODEL_API_KEY to let Muse choose files, chat modules, and plan tabs. See docs/RESTORE_MUSE.md.
# Google Drive is optional. Pytest sets HUDDLE_OFFLINE=1 and does not use these keys.

# Meta Model API (Muse Spark) — https://dev.meta.ai  (API keys tab; keys start with LLM_)
# Leave MUSE_ENABLED unset until that doc's steps are done. Credits show under Billing and Usage.
MODEL_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
# MUSE_ENABLED=1

# SerpApi — https://serpapi.com/manage-api-key
# Live responses are cached in fixtures/serpapi/. Delete a file to fetch it again.
SERPAPI_API_KEY=

# Google Drive is optional. Leave these blank and the plan folder stays in the app.
# The app returns 503 until SerpAPI is set. Folder builds do not call Muse.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the web client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Seconds between steps in mock builds, so the app's progress list visibly fills in.
HUDDLE_MOCK_PACE=0.25

# Muse price watch (huddle/watch.py): seconds between background re-checks of every watched price.
# 21600 = every 6 hours. Use 60 for a live demo; 0 turns the sweep off (the app's refresh still checks).
HUDDLE_WATCH_INTERVAL=21600
# Alert when a price moves at least 3% and at least $5.
HUDDLE_WATCH_THRESHOLD=0.03
HUDDLE_WATCH_MIN_MOVE=5
# Without SERPAPI_API_KEY, mock prices drift on a wave this many seconds long so watches have something to catch.
HUDDLE_MOCK_DRIFT=60
